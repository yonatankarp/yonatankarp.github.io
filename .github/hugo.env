# The one Hugo pin. The build-site action installs this release and checks the .deb against HUGO_SHA256,
# which is the hugo_<version>_linux-amd64.deb line of the release's hugo_<version>_checksums.txt,
# so the two change together. scripts/check-hugo-pin.js and scripts/run-hugo.js read it too.
HUGO_VERSION=0.170.1
HUGO_SHA256=df49c8227fd5e97580d1b017850e03895f730e07cb65f9f7599d4e14331d33b4
