{
  "scripts": {
    "build": "node scripts/run-hugo.js --gc --minify --cleanDestinationDir",
    "build:local": "node scripts/run-hugo.js --gc --minify --cleanDestinationDir",
    "check": "npm run check:blog-assets && (npm run build || npm run build:local) && npm run check:site-metadata && npm run check:generated-html && npm run check:cv-print && npm run check:links",
    "check:blog-assets": "node scripts/check-blog-assets.js",
    "check:cv-print": "node scripts/check-cv-print.js",
    "check:generated-html": "node scripts/check-generated-html.js",
    "check:links": "node scripts/check-links.js",
    "check:links:external": "node scripts/check-links.js --external",
    "check:site-metadata": "node scripts/check-site-metadata.js",
    "project-thumbnails:generate": "node scripts/generate-project-thumbnails.js",
    "visual:capture": "node scripts/capture-screenshots.js",
    "serve": "node scripts/run-hugo.js server",
    "serve:local": "node scripts/run-hugo.js server"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
