# The one Hugo pin. The build-site action installs this release and checks the .deb against HUGO_SHA256,
# which is the hugo_extended_<version>_linux-amd64.deb line of the release's hugo_<version>_checksums.txt,
# so the two change together. scripts/check-hugo-pin.js and scripts/run-hugo.js read it too.
HUGO_VERSION=0.169.0
HUGO_SHA256=a20f7da84e0981bebbecc032cc87f0dda2049a844727720aab14e61ce416e5e9
